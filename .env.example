HTTP_PORT=8080
DB_DSN=postgres://appuser:apppassword@localhost:5432/cleanapi?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
BOOKING_HOLD_MINUTES=10
# Hours an owner has to approve a booking before it's cancelled and refunded.
OWNER_APPROVAL_HOURS=24

# Requests must carry the gateway's secret or the service-to-service key.
# Must match the gateway / the other services.
GATEWAY_INTERNAL_SECRET=dev-gateway-secret-change-me
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

AUTH_SERVICE_URL=http://localhost:8000
PARKING_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:8004

# Cloudflare R2, PRIVATE bucket for payout proofs (bank-transfer receipts) --
# deliberately separate from the public photos bucket auth-service/
# parking-service use. No R2_PUBLIC_URL here on purpose: reads go through
# short-lived presigned URLs (see internal/repository/storage.Client), never
# a fixed public one.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PAYOUT_PROOFS_BUCKET_NAME=

# Sentry error reports. Empty DSN = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Demo data: reviews for the demo parking spots, loaded at startup. false turns it off.
SEED_DEMO_DATA=true
